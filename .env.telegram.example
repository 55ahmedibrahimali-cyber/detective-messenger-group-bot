# Copy this file to .env.telegram and configure the Telegram bot independently
# from Messenger's .env. Do not share or commit .env.telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Dedicated Telegram database; never reuse Messenger's database name.
TELEGRAM_DB_NAME=detective_bot_telegram
TELEGRAM_DB_HOST=127.0.0.1
TELEGRAM_DB_PORT=3306
TELEGRAM_DB_USER=root
TELEGRAM_DB_PASSWORD=
TELEGRAM_DB_SSL=0
TELEGRAM_DB_SSL_CA=
TELEGRAM_DB_CREATE_DATABASE=1

# Telegram uses a separate local drawing server and Tailscale Funnel port.
TELEGRAM_DRAWING_PORT=3101
TELEGRAM_FUNNEL_PORT=8443
DRAWING_TUNNEL_PROVIDER=auto
DRAWING_TUNNEL_WATCHDOG_SECONDS=60
DRAWING_TUNNEL_FALLBACK=1
DRAWING_TUNNEL_KEEP_ALIVE=0
TAILSCALE_PATH=
CLOUDFLARED_PATH=
SPY_IMAGE_PUBLIC_BASE_URL=
SPY_IMAGE_LINK_TTL_SECONDS=7200
SPY_IMAGE_LINK_SECRET=
SPY_IMAGE_DELIVERY=attachment

# Game media configuration is independent for Telegram.
# If Telegram uses its separate environment, copy the Workers AI credentials here too.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-20b
CLOUDFLARE_AI_FALLBACK_MODEL=
# Design assistant image model (Workers AI); reference images are resized to at most 512px.
CLOUDFLARE_DESIGN_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
CLOUDFLARE_DESIGN_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# Free image fallback used when Cloudflare image generation is unavailable.
# Create a free account/API key at https://stablehorde.net/.
AI_HORDE_API_KEY=
AI_CHAT_PROVIDER=cloudflare
AI_CHAT_CONTEXT_MESSAGES=30
# Optional Groq provider: set AI_CHAT_PROVIDER=groq and provide GROQ_API_KEY.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Dedicated crime-game generator and Wikipedia pattern library.
CRIME_AI_PROVIDER=cloudflare
CRIME_AI_MODEL=
CRIME_AI_FALLBACK_MODEL=
CRIME_WIKIPEDIA_LANGUAGE=en
# Gemini is optional for game images and for crime AI if selected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Opt in to Cloudflare Workers AI image analysis; a square image preview is sent to Cloudflare.
STORM_LOGO_AI_ANALYSIS=0
STORM_LOGO_AI_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
CRIME_PATTERNS=1
# Gemini game-image fallback; the design assistant uses Cloudflare.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_FALLBACK_MODELS=gemini-3.1-flash-image,gemini-3.1-flash-lite-image,gemini-3-pro-image,gemini-2.5-flash-image
PIXABAY_API_KEY=
PINTEREST_ENABLED=1
PINTEREST_MAX_IMAGES=5
PINTEREST_USER_COOLDOWN_SECONDS=300
PINTEREST_THREAD_COOLDOWN_SECONDS=8
PINTEREST_MAX_REQUESTS_PER_HOUR=60
PINTEREST_MAX_IMAGES_PER_HOUR=100
PINTEREST_BLOCKED_TERMS=
PINTEREST_PROGRESS_NOTICE=0
DEVIANTART_ENABLED=1
DEVIANTART_CLIENT_ID=
DEVIANTART_CLIENT_SECRET=
DEVIANTART_MAX_IMAGES=5
DEVIANTART_USER_COOLDOWN_SECONDS=20
DEVIANTART_THREAD_COOLDOWN_SECONDS=8
DEVIANTART_MAX_REQUESTS_PER_HOUR=60
DEVIANTART_MAX_IMAGES_PER_HOUR=100
DEVIANTART_BLOCKED_TERMS=
# Anime image-to-video edits use Fal.ai; add the key locally, never to Git.
FAL_KEY=
FAL_ANIME_EDIT_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
AI_CHAT_TRIGGERS=يا جود,جود,jood
AI_CHAT_COOLDOWN_SECONDS=8
AI_CHAT_MAX_REPLIES_PER_HOUR=40
AI_CHAT_MAX_REPLY_CHARS=700

# Independent game settings (change only those you want to override).
MIN_PLAYERS=4
MAX_PLAYERS=8
DISCUSSION_SECONDS=120
VOTING_SECONDS=60
CRIME_LOBBY_SECONDS=60
STORM_MIN_PLAYERS=4
STORM_MAX_PLAYERS=8
STORM_LOBBY_SECONDS=60
STORM_NIGHT_SECONDS=45
STORM_DISCUSSION_SECONDS=90
STORM_VOTING_SECONDS=45
SPY_MIN_PLAYERS=3
SPY_MAX_PLAYERS=8
SPY_LOBBY_SECONDS=60
SPY_DISCUSSION_SECONDS=180
SPY_VOTING_SECONDS=60
FEIGN_MIN_PLAYERS=4
FEIGN_MAX_PLAYERS=12
FEIGN_LOBBY_SECONDS=60
FEIGN_NIGHT_SECONDS=45
FEIGN_DISCUSSION_SECONDS=90
FEIGN_VOTING_SECONDS=45
WEREWOLF_LOBBY_SECONDS=60
WEREWOLF_NIGHT_SECONDS=60
WEREWOLF_DISCUSSION_SECONDS=120
WEREWOLF_VOTING_SECONDS=60
WEREWOLF_HUNTER_SECONDS=30
DRAWING_TOKEN_TTL_MINUTES=180
DRAWING_IMAGE_MAX_BYTES=2097152
DRAWING_PUBLISH_INTERVAL_SECONDS=30

# Telegram-specific send protection and private-chat state.
MAX_SENDS_PER_MINUTE=30
MAX_SENDS_PER_HOUR=200
MAX_SENDS_PER_DAY=1200
STRICT_PRIVATE=1
QUIET_HOURS=

# Copy any desired game timing/player-count overrides from .env.example below.
