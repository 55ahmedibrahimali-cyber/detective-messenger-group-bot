[Unit]
Description=Detective Messenger group bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=detective-bot
Group=detective-bot
WorkingDirectory=/opt/detective-bot
ExecStart=/usr/bin/env node /opt/detective-bot/server.js
Restart=on-failure
RestartSec=30s
StartLimitIntervalSec=300
StartLimitBurst=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
