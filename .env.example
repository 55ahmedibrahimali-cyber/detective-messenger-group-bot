# --- حساب فيسبوك الخاص بالبوت (استخدم حساباً مخصصاً وليس حسابك الشخصي!) ---
# appstate يستخدم appstate.json؛ password وauto متاحان عند الحاجة.
LOGIN_MODE=appstate
# مطلوب عند استخدام LOGIN_MODE=password؛ استخدم حساباً مخصصاً للبوت.
FB_EMAIL=
FB_PASSWORD=
# يستخدم فقط مع LOGIN_MODE=appstate أو auto لتشفير الجلسة المحفوظة.
APPSTATE_ENCRYPTION_KEY=
# ساعات إيقاف محاولات الدخول بعد رفض فيسبوك (يحمي الحساب من القفل)
LOGIN_LOCK_HOURS=6
APPSTATE_PATH=./appstate.json
# مكتبة FCA واحدة لكل تشغيل: hridoy-fca أو @dongdev/fca-unofficial أو fca-azadx69x
# fbapi-unofficial مثبّت باسم facebook-chat-api ويتطلب Node.js 22.23.2 أو أحدث.
FCA_MODULE=hridoy-fca
# يمنع محرك E2EE إضافياً من طرد اتصال DM الأساسي في hridoy-fca
FCA_E2EE_NATIVE=0
# تجريبي: أرسل صور الخاص عبر محرك E2EE الأصلي (قد يفصل جلسة جهاز).
# مطلوب للمرفقات المباشرة عند استخدام SPY_IMAGE_DELIVERY=attachment أو both.
FCA_E2EE_NATIVE_DM_IMAGES=0
# قبول طلبات الرسائل الخاصة تلقائياً (لازم ليصل تصويت/أدوار اللاعبين غير الأصدقاء)
AUTO_ACCEPT_REQUESTS=true
# فاصل عشوائي بين كل رسالتين يرسلهما البوت (يقلل خطر الحظر)
SEND_DELAY_MIN_MS=1200
SEND_DELAY_MAX_MS=2800

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=detective_bot
# Set to 1 for managed databases that require TLS; certificate verification stays enabled.
DB_SSL=0
# Optional CA certificate in PEM format; replace literal \n with line breaks automatically.
DB_SSL_CA=
# Set to 0 when the hosting panel has already created the database.
DB_CREATE_DATABASE=1


# الذكاء الاصطناعي المتخصص للعبة: يستخدم Cloudflare Workers AI افتراضياً
CRIME_AI_PROVIDER=cloudflare
CRIME_AI_MODEL=
CRIME_AI_FALLBACK_MODEL=
CRIME_WIKIPEDIA_LANGUAGE=en
# Gemini اختياري كبديل للقضايا أو صور بعض الألعاب؛ أنشئ مفتاحاً من https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Opt in to Cloudflare Workers AI image analysis; a square image preview is sent to Cloudflare.
STORM_LOGO_AI_ANALYSIS=0
STORM_LOGO_AI_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# لا تستخدم اللعبة إلا بطاقات الأنماط المجرّدة التي اعتمدها المشرف
CRIME_PATTERNS=1
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Models are tried in order when the primary game-image model is unavailable.
GEMINI_IMAGE_FALLBACK_MODELS=gemini-3.1-flash-image,gemini-3.1-flash-lite-image,gemini-3-pro-image,gemini-2.5-flash-image

# مزوّد الذكاء الاصطناعي الافتراضي للشات والقضايا: Cloudflare Workers AI.
# أضف معرّف الحساب ورمز API من Cloudflare؛ لا تضع الرمز في المحادثة أو Git.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-20b
CLOUDFLARE_AI_FALLBACK_MODEL=
# Design assistant image model (Workers AI); reference images are resized to at most 512px.
CLOUDFLARE_DESIGN_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
CLOUDFLARE_DESIGN_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# Free image fallback used when Cloudflare image generation is unavailable.
# Create a free account/API key at https://stablehorde.net/.
AI_HORDE_API_KEY=
AI_CHAT_PROVIDER=cloudflare
# Groq اختياري: اختر AI_CHAT_PROVIDER=groq للشات وCRIME_AI_PROVIDER=groq للقضايا.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# تنبيه خصوصية: تُرسل رسائل مناداة جود أو الرد عليها وسياق ردودها إلى مزوّد الذكاء الاصطناعي السحابي المختار.
# فعّلها لكل محادثة بأمر /تكلم وأوقفها بأمر /اسكت؛ في المجموعات للأدمن فقط.
AI_CHAT_TRIGGERS=يا جود,جود,jood,joud
AI_CHAT_COOLDOWN_SECONDS=3
AI_CHAT_MAX_REPLIES_PER_HOUR=60
AI_CHAT_MAX_REPLY_CHARS=700
# عدد الرسائل الأخيرة التي تفهمها جود.
AI_CHAT_CONTEXT_MESSAGES=30
AI_CHAT_TEMPERATURE=0.85

# إعدادات اللعبة
MIN_PLAYERS=4
MAX_PLAYERS=8
DISCUSSION_SECONDS=120
VOTING_SECONDS=60

# إمبراطورية STORM (مستقلة عن إعدادات لعبة التحقيق)
STORM_MIN_PLAYERS=4
STORM_MAX_PLAYERS=8
STORM_LOBBY_SECONDS=60
STORM_NIGHT_SECONDS=45
STORM_DISCUSSION_SECONDS=90
STORM_VOTING_SECONDS=45

# لعبة الجاسوس
# أنشئ مفتاح Pixabay API من https://pixabay.com/api/docs/ وأضفه محلياً؛ لا ترفعه إلى Git.
PIXABAY_API_KEY=
PINTEREST_ENABLED=1
PINTEREST_MAX_IMAGES=5
PINTEREST_USER_COOLDOWN_SECONDS=20
PINTEREST_THREAD_COOLDOWN_SECONDS=8
PINTEREST_MAX_REQUESTS_PER_HOUR=60
PINTEREST_MAX_IMAGES_PER_HOUR=100
PINTEREST_BLOCKED_TERMS=
PINTEREST_PROGRESS_NOTICE=0
DEVIANTART_ENABLED=1
DEVIANTART_CLIENT_ID=
DEVIANTART_CLIENT_SECRET=
DEVIANTART_MAX_IMAGES=5
DEVIANTART_USER_COOLDOWN_SECONDS=20
DEVIANTART_THREAD_COOLDOWN_SECONDS=8
DEVIANTART_MAX_REQUESTS_PER_HOUR=60
DEVIANTART_MAX_IMAGES_PER_HOUR=100
DEVIANTART_BLOCKED_TERMS=
# Reply-based fun effects are limited to groups; a clarification follows immediately.
FUN_COMMANDS_ENABLED=1
FUN_USER_COOLDOWN_SECONDS=15
FUN_HACK_STEP_DELAY_MS=1800
# The "ايديت" command uses Fal.ai; add the key locally, never to Git.
FAL_KEY=
FAL_ANIME_EDIT_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
# The separate "فيديو" command uses this public Hugging Face ZeroGPU Space.
# Its free quota is limited and the queue may be slow; images are sent to the Space.
# HF_TOKEN is optional, but authenticate with a Hugging Face account to use its quota.
HF_TOKEN=
HF_IMAGE_TO_VIDEO_SPACE_URL=https://upsampler-wan-2-2-14b-image-to-video.hf.space
SPY_MIN_PLAYERS=3
SPY_MAX_PLAYERS=8
SPY_LOBBY_SECONDS=60
SPY_DISCUSSION_SECONDS=180
SPY_VOTING_SECONDS=60
# Optional stable HTTPS origin for this bot's web server. If blank, the drawing
# game starts the configured tunnel provider when a game begins.
SPY_IMAGE_PUBLIC_BASE_URL=
# Tunnel provider: auto tries Tailscale Funnel first, then Cloudflare Quick Tunnel.
DRAWING_TUNNEL_PROVIDER=auto
# Probe the public drawing tunnel every 60 seconds; 0 disables automatic recovery.
DRAWING_TUNNEL_WATCHDOG_SECONDS=60
# 1 tries Cloudflare if Tailscale fails; set to 0 to require the selected provider.
DRAWING_TUNNEL_FALLBACK=1
# Keep a bot-created Tailscale Funnel configured after the drawing game ends.
DRAWING_TUNNEL_KEEP_ALIVE=0
# Optional path if tailscale is not available on PATH.
TAILSCALE_PATH=
# Optional path if cloudflared is not available on PATH.
CLOUDFLARED_PATH=
SPY_IMAGE_PORT=3000
SPY_IMAGE_LINK_TTL_SECONDS=7200
# Optional. If omitted, a random signing secret is created in the ignored .nexca directory.
SPY_IMAGE_LINK_SECRET=

# The drawing page URL is private to each player and periodically uploads PNG snapshots.
DRAWING_TOKEN_TTL_MINUTES=180
DRAWING_IMAGE_MAX_BYTES=2097152
DRAWING_PUBLISH_INTERVAL_SECONDS=30

# لعبة فيجن (Feign)
FEIGN_MIN_PLAYERS=4
FEIGN_MAX_PLAYERS=12
FEIGN_LOBBY_SECONDS=60
FEIGN_NIGHT_SECONDS=45
FEIGN_DISCUSSION_SECONDS=90
FEIGN_VOTING_SECONDS=45

# لعبة المستذئب (Werewolf / The Werewolves of Miller's Hollow)
# عدد اللاعبين ثابت: 4 إلى 8.
WEREWOLF_LOBBY_SECONDS=60
WEREWOLF_NIGHT_SECONDS=60
WEREWOLF_DISCUSSION_SECONDS=120
WEREWOLF_VOTING_SECONDS=60
WEREWOLF_HUNTER_SECONDS=30

# --- حدود الأمان ---
# أقصى عدد رسائل يرسلها البوت في الدقيقة
MAX_SENDS_PER_MINUTE=12
# حدّان إضافيان للإرسال في الساعة واليوم
MAX_SENDS_PER_HOUR=200
MAX_SENDS_PER_DAY=1200
# لا يرسل الخاص إلا لمن بدأ محادثة مع البوت؛ استخدم 0 لتعطيل هذا الشرط
STRICT_PRIVATE=1
# اختياري: ساعات هدوء حسب ساعة الجهاز، مثال 3-7
QUIET_HOURS=
# حد رسائل المستخدم في المحادثة الواحدة (رسائل / ثواني) وإلا تُتجاهل
USER_RATE_LIMIT_COUNT=20
USER_RATE_LIMIT_SECONDS=10
# أقصى أحداث معلّقة لكل مجموعة/محادثة خاصة؛ عند الامتلاء يُسجّل تحذير وتُهمل الأحداث الجديدة.
MAX_PENDING_EVENTS_PER_KEY=200
# اختياري: معرّفات المجموعات المسموح لها فقط (مفصولة بفواصل). فارغ = كل المجموعات
ALLOWED_THREAD_IDS=
# محاولات إعادة إرسال الصور عند الفشل العابر
SEND_IMAGE_RETRIES=2
# انتظار (ثوانٍ) قبل إعادة إرسال أدوار الجاسوس لمن لم تصلهم
SPY_DELIVERY_RETRY_SECONDS=25
CRIME_LOBBY_SECONDS=60

# If Messenger and Telegram run on the same host, keep Messenger on its default
# port 443 and configure Telegram's independent port in .env.telegram.
TAILSCALE_FUNNEL_PORT=443

# طريقة إرسال صورة الجاسوس: attachment | link (رابط موقّع) | host (رابط مؤقت) | both (رابط مؤقت + مرفق مباشر).
# both يحتاج FCA_E2EE_NATIVE_DM_IMAGES=1؛ يبقى الرابط بديلاً إذا فشل المرفق المباشر.
SPY_IMAGE_DELIVERY=host
# host = استضافة مؤقتة جاهزة (litterbox) بلا نفق | link = رابط من خادمك + نفق | attachment = مرفق | both
# مدة بقاء الصورة على الاستضافة: 1h | 12h | 24h | 72h
SPY_IMAGE_HOST_TTL=1h

# ---- ثبات الاتصال (يقلل عدد تسجيلات الدخول الجديدة = أمان أعلى للحساب) ----
# عدد محاولات إعادة الاستماع على نفس الجلسة قبل اللجوء لتسجيل دخول جديد
MQTT_SOFT_RETRIES=3
# فحص طلبات الرسائل (بالثواني، مع عشوائية ±25%)
ACCEPT_REQUESTS_SECONDS=240
# مهم: ثبّت USER_AGENT نفسه الذي أنشأت به الجلسة، ولا تغيّره لاحقاً
# USER_AGENT=
