# Secrets and runtime-only settings. Other settings are in config/general.json and games/*/config.json.
FB_EMAIL=
FB_PASSWORD=
FB_2FA_SECRET=
APPSTATE_ADMIN_KEY=
AUTO_RENEW_APPSTATE=1
APPSTATE_REFRESH_INTERVAL_MINUTES=30
APPSTATE_ENCRYPTION_KEY=
# Copy the exact navigator.userAgent value from the browser session that exported appstate.
USER_AGENT=
# Optional; use only a fixed proxy that matches your manually verified login network path.
HTTPS_PROXY=
DB_PASSWORD=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
AI_HORDE_API_KEY=
GROQ_API_KEY=
PIXABAY_API_KEY=
DEVIANTART_CLIENT_SECRET=
FAL_KEY=
HF_TOKEN=
SPY_IMAGE_LINK_SECRET=

# Optional: Human-like behavior overrides (typing indicator, seen status, delays)
# See env-recovery-mode.txt for strict recovery settings after a checkpoint
# HUMANIZE_ENABLED=1
# HUMANIZE_MARK_SEEN=1
# HUMANIZE_TYPING=1
# HUMANIZE_TYPING_WPM=38
# HUMANIZE_MIN_TYPING_MS=700
# HUMANIZE_MAX_TYPING_MS=6000
# HUMANIZE_MICRO_BREAK_CHANCE=0.05
# HUMANIZE_MICRO_BREAK_MIN_MS=8000
# HUMANIZE_MICRO_BREAK_MAX_MS=25000
